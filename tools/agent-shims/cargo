#!/usr/bin/env bash
# cargo shim for implementation agents.
#
# Two rules, enforced here so no brief has to ask for them:
#   1. Only one compilation runs at a time on this machine (a global flock).
#   2. Every compilation runs inside a transient cgroup capped at 4 GB.
#
# Cheap, read-only subcommands skip the lock. Everything else queues.
# If the capped build is OOM-killed, retry once with a single job, then fail loudly.
set -u

real_cargo="${AGENT_SHIM_REAL_CARGO:-$HOME/.cargo/bin/cargo}"
if [[ ! -x "$real_cargo" ]]; then
  real_cargo="$(PATH="${PATH//$HOME\/.local\/bin\/agent-shims:/}" command -v cargo || true)"
fi
if [[ -z "$real_cargo" || ! -x "$real_cargo" ]]; then
  echo "agent-shim: no real cargo found" >&2
  exit 127
fi

lock_dir="${XDG_RUNTIME_DIR:-/tmp}"
lock_file="$lock_dir/agent-build.lock"
holder_file="$lock_dir/agent-build.holder"
mem_max="${AGENT_MEM_MAX:-infinity}"  # the 4 GB gate was dropped on 2026-09-25 (memory pressure gone)
jobs="${CARGO_BUILD_JOBS:-8}"

sub="${1:-}"
case "$sub" in
  fmt|tree|metadata|deny|new|init|add|remove|rm|update|generate-lockfile|clean|fetch|vendor|--version|-V|--list|help|-h|--help|version|search|owner|login|logout|yank|read-manifest|locate-project|pkgid|verify-project|"")
    exec "$real_cargo" "$@"
    ;;
esac

# Share compiled dependencies across every worktree once sccache is installed.
if [[ -z "${RUSTC_WRAPPER:-}" ]] && command -v sccache >/dev/null 2>&1; then
  export RUSTC_WRAPPER=sccache
  # Start the server here, outside the lock and outside any capped scope, so it neither
  # inherits the lock descriptor nor counts against one build's memory cap.
  sccache --start-server >/dev/null 2>&1 || true
fi

run_capped() {
  local j="$1"; shift
  local unit="agent-cargo-$$-$RANDOM"
  # Hard cap only; MemoryHigh would throttle instead of kill and hide the overrun.
  # `9>&-`: the build must not inherit the lock descriptor. The sccache server started by
  # the first compile daemonizes and outlives the build; holding fd 9 it keeps the lock taken
  # after the build ends, and every later build waits on a lock nobody is using.
  CARGO_BUILD_JOBS="$j" systemd-run --user --scope --quiet --collect \
    --unit="$unit" \
    -p MemoryMax="$mem_max" -p MemorySwapMax=0 \
    -- "$real_cargo" "$@" 9>&- 10>&- 11>&- 12>&-
}

wait_note() {
  local holders
  holders="$(cat "$lock_dir"/agent-build.holder.* 2>/dev/null | tr '\n' ';')"
  echo "agent-shim: waiting for a build slot (held by: ${holders:-unknown})" >&2
}

# Build slots: at most AGENT_BUILD_SLOTS compilations run at once (no memory cap by default since 2026-09-25).
slots="${AGENT_BUILD_SLOTS:-6}"
slot=""
acquire_slot() {
  local i
  for ((i = 0; i < slots; i++)); do
    eval "exec $((9 + i))>\"$lock_file.$i\""
    if flock -n $((9 + i)); then slot=$i; return 0; fi
  done
  return 1
}
if ! acquire_slot; then
  wait_note
  while ! acquire_slot; do sleep 3; wait_note; done
fi
holder_file="$holder_file.$slot"
echo "pid $$ in $(pwd): cargo $*" >"$holder_file"

run_capped "$jobs" "$@"
status=$?
if [[ $status -eq 137 || $status -eq 143 ]] && [[ "$jobs" != "1" ]]; then
  echo "agent-shim: build was killed at the $mem_max cap; retrying with CARGO_BUILD_JOBS=1" >&2
  run_capped 1 "$@"
  status=$?
fi
if [[ $status -eq 137 ]]; then
  echo "agent-shim: build exceeded the $mem_max memory cap even with one job. Report this; do not work around it." >&2
fi
: >"$holder_file"
exit $status
