#!/usr/bin/env bash
# Run a command inside a transient cgroup capped at 16 GB (no swap).
# Only for tools that must map model weights (ComfyUI, LoRA training); builds use limit4g.
set -u
if [[ $# -eq 0 ]]; then
  echo "usage: limit16g <command> [args...]" >&2
  exit 64
fi
exec systemd-run --user --scope --quiet --collect \
  --unit="agent-limit16-$$-$RANDOM" \
  -p MemoryMax=16G -p MemorySwapMax=0 \
  -- "$@"
